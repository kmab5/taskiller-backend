# Runtime
TASKILLER_ENV=local
TASKILLER_HOST=0.0.0.0
TASKILLER_PORT=8000
TASKILLER_LOG_LEVEL=INFO
TASKILLER_API_PREFIX=/api/v1
TASKILLER_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL - local Docker example. Neon will provide the production URL.
TASKILLER_DATABASE_URL=postgresql+psycopg://taskiller:taskiller@localhost:5432/taskiller

# Authentication
# Generate independent production secrets with: openssl rand -hex 32
TASKILLER_JWT_SECRET=change-me-in-local-development
TASKILLER_TOKEN_HASH_SECRET=change-me-in-local-development-token-hash
TASKILLER_AUTH_ISSUER=taskiller
TASKILLER_AUTH_AUDIENCE=taskiller-api
TASKILLER_ACCESS_TOKEN_TTL_SECONDS=900
TASKILLER_REFRESH_TOKEN_TTL_DAYS=30
TASKILLER_EMAIL_VERIFICATION_TTL_MINUTES=60
TASKILLER_PASSWORD_RESET_TTL_MINUTES=30

# Retain completed mutation replay records for retry safety.
TASKILLER_IDEMPOTENCY_TTL_HOURS=24

# Refresh credential cookie. Production should normally use a custom api.taskiller.* domain.
TASKILLER_REFRESH_COOKIE_SAMESITE=lax
# TASKILLER_REFRESH_COOKIE_DOMAIN=.taskiller.example
# TASKILLER_REFRESH_COOKIE_SECURE=true

# Privacy / operations
TASKILLER_ACCOUNT_DELETION_GRACE_DAYS=7
TASKILLER_EXPORT_TTL_HOURS=24
TASKILLER_EXPORT_DOWNLOAD_TTL_SECONDS=600
TASKILLER_OUTBOX_LEASE_SECONDS=60
TASKILLER_OUTBOX_POLL_SECONDS=2
TASKILLER_OUTBOX_MAX_ATTEMPTS=5
TASKILLER_SECURITY_EVENT_RETENTION_DAYS=90

# Sensitive-endpoint rate limits
TASKILLER_AUTH_LOGIN_LIMIT=10
TASKILLER_AUTH_LOGIN_WINDOW_SECONDS=900
TASKILLER_AUTH_REGISTER_LIMIT=5
TASKILLER_AUTH_REGISTER_WINDOW_SECONDS=3600
TASKILLER_AUTH_PASSWORD_RESET_LIMIT=5
TASKILLER_AUTH_PASSWORD_RESET_WINDOW_SECONDS=900
