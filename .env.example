# Runtime
TASKILLER_ENV=local
TASKILLER_HOST=0.0.0.0
TASKILLER_PORT=8000
TASKILLER_LOG_LEVEL=INFO
TASKILLER_API_PREFIX=/api/v1
TASKILLER_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL - local Docker example. Neon will provide the production URL.
TASKILLER_DATABASE_URL=postgresql+psycopg://taskiller:taskiller@localhost:5432/taskiller

# Authentication (implemented in Round 2)
# Generate a production secret with: openssl rand -hex 32
TASKILLER_JWT_SECRET=change-me-in-local-development
TASKILLER_AUTH_ISSUER=taskiller
TASKILLER_AUTH_AUDIENCE=taskiller-api
TASKILLER_ACCESS_TOKEN_TTL_SECONDS=900
TASKILLER_REFRESH_TOKEN_TTL_DAYS=30
