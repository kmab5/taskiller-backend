# Runtime
TASKILLER_ENV=local
TASKILLER_HOST=0.0.0.0
TASKILLER_PORT=8000
TASKILLER_LOG_LEVEL=INFO
TASKILLER_API_PREFIX=/api/v1
TASKILLER_CORS_ORIGINS=["http://localhost:3000"]
TASKILLER_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
TASKILLER_TRUST_FORWARDED_FOR=false
TASKILLER_SECURITY_HEADERS_ENABLED=true
TASKILLER_HSTS_MAX_AGE_SECONDS=31536000
TASKILLER_EMBEDDED_WORKER_ENABLED=false

# PostgreSQL - local Docker example. Use Neon's pooled URL in deployed environments.
TASKILLER_DATABASE_URL=postgresql+psycopg://taskiller:taskiller@localhost:5432/taskiller
TASKILLER_DATABASE_POOL_SIZE=5
TASKILLER_DATABASE_MAX_OVERFLOW=5
TASKILLER_DATABASE_POOL_TIMEOUT_SECONDS=10
TASKILLER_DATABASE_POOL_RECYCLE_SECONDS=300

# Authentication email. Production supports Resend HTTPS API or SMTP.
TASKILLER_EMAIL_DELIVERY_MODE=development_log
TASKILLER_WEB_APP_URL=http://localhost:5173
# Recommended for Render Free:
# TASKILLER_RESEND_API_KEY=re_xxxxxxxxx
# TASKILLER_RESEND_FROM_EMAIL=Taskiller <noreply@your-domain.com>
# TASKILLER_RESEND_API_URL=https://api.resend.com
# TASKILLER_RESEND_TIMEOUT_SECONDS=10
# SMTP alternative:
# TASKILLER_SMTP_HOST=smtp.example.com
# TASKILLER_SMTP_PORT=587
# TASKILLER_SMTP_USERNAME=
# TASKILLER_SMTP_PASSWORD=
# TASKILLER_SMTP_FROM_EMAIL=Taskiller <noreply@example.com>
# TASKILLER_SMTP_STARTTLS=true
# TASKILLER_SMTP_TIMEOUT_SECONDS=10

# Authentication
# Generate independent production secrets with: openssl rand -hex 32
TASKILLER_JWT_SECRET=change-me-in-local-development
TASKILLER_TOKEN_HASH_SECRET=change-me-in-local-development-token-hash
TASKILLER_AUTH_ISSUER=taskiller
TASKILLER_AUTH_AUDIENCE=taskiller-api
TASKILLER_ACCESS_TOKEN_TTL_SECONDS=900
TASKILLER_REFRESH_TOKEN_TTL_DAYS=30
TASKILLER_EMAIL_VERIFICATION_TTL_MINUTES=60
TASKILLER_PASSWORD_RESET_TTL_MINUTES=30

# Retain completed mutation replay records for retry safety.
TASKILLER_IDEMPOTENCY_TTL_HOURS=24

# Refresh credential cookie. Use SameSite=none + Secure for a genuinely cross-site web client.
TASKILLER_REFRESH_COOKIE_SAMESITE=lax
# TASKILLER_REFRESH_COOKIE_DOMAIN=.taskiller.example
# TASKILLER_REFRESH_COOKIE_SECURE=true

# Privacy / operations
TASKILLER_ACCOUNT_DELETION_GRACE_DAYS=7
TASKILLER_DELETION_TOMBSTONE_RETENTION_DAYS=30
TASKILLER_EXPORT_TTL_HOURS=24
TASKILLER_EXPORT_DOWNLOAD_TTL_SECONDS=600
TASKILLER_OUTBOX_LEASE_SECONDS=60
TASKILLER_OUTBOX_POLL_SECONDS=2
TASKILLER_OUTBOX_MAX_ATTEMPTS=5
TASKILLER_OUTBOX_HISTORY_RETENTION_DAYS=14
TASKILLER_SECURITY_EVENT_RETENTION_DAYS=90
TASKILLER_RATE_LIMIT_BUCKET_RETENTION_SECONDS=172800

# Sensitive-endpoint rate limits
TASKILLER_AUTH_LOGIN_LIMIT=10
TASKILLER_AUTH_LOGIN_WINDOW_SECONDS=900
TASKILLER_AUTH_REGISTER_LIMIT=5
TASKILLER_AUTH_REGISTER_WINDOW_SECONDS=3600
TASKILLER_AUTH_PASSWORD_RESET_LIMIT=5
TASKILLER_AUTH_PASSWORD_RESET_WINDOW_SECONDS=900

# Optional build metadata. Render Git deployments provide RENDER_GIT_* automatically.
# TASKILLER_RELEASE_SHA=
# TASKILLER_RELEASE_BRANCH=main
# TASKILLER_RELEASE_REPOSITORY=https://github.com/kmab5/taskiller-backend
